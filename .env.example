# API
NODE_ENV=development
PORT=3001
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT de superadmins de plataforma (POST /platform/*): secret y expiración
# propios, sin relación con los tokens de tenant.
PLATFORM_JWT_SECRET=change_me_platform_secret_dev_only
PLATFORM_JWT_EXPIRES_IN=8h

# Database (platform / public schema)
DATABASE_URL=postgresql://eduapp:eduapp@localhost:5432/eduapp

# Redis
REDIS_URL=redis://localhost:6379

# Resolución de tenant en desarrollo: además del host real, acepta el header
# `x-tenant-subdomain` para no depender de subdominios locales. Debe estar
# deshabilitado en producción.
TENANT_HEADER_OVERRIDE_ENABLED=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# Debe coincidir con el subdominio del tenant creado por `seed:dev`.
NEXT_PUBLIC_TENANT_SUBDOMAIN=colegio-demo
